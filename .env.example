# Copy to .env.local and fill in (npm run setup does the copy and generates
# NEXTAUTH_SECRET for you). Never commit .env.local.

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://researchagent:researchagent@localhost:5432/researchagent?schema=public"

# Auth — sign-in with GitHub. Create an OAuth app at https://github.com/settings/developers
# with the callback URL http://localhost:3000/api/auth/callback/github
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"

# AI — Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Web Search — Tavily (sign up free at https://tavily.com)
TAVILY_API_KEY="tvly-..."

# Background Jobs — Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Optional: the worker's JSON log of agent actions. compact (default) clips long
# values, full logs them whole, off turns it off.
# AGENT_LOG="compact"
