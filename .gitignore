# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.key

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# prisma — generated client (if output is set inside the repo) and local SQLite files
/src/generated/
/prisma/*.db
/prisma/*.db-journal

# local scratch: agent test runs, exported reports
/tmp/
/scripts/output/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
